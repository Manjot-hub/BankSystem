# Banking Chatbot Configuration
# Copy to .env and fill in your values

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_org_id_here

# Embedding Model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=100

# LLM Models
LLM_MODEL_PRIMARY=gpt-4o-mini
LLM_MODEL_FALLBACK=gpt-3.5-turbo
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000

# Vector Database (Chroma for local dev)
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=banking_knowledge

# Qdrant (for production)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=banking_knowledge

# Redis (for sessions, caching, rate limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=3600
REDIS_RATE_LIMIT_WINDOW=60
REDIS_RATE_LIMIT_MAX_REQUESTS=30

# Database (PostgreSQL for audit logs, user context)
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/bank_chatbot

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TIMEOUT=30

# LangSmith (Observability)
LANGSMITH_API_KEY=your_langsmith_key
LANGSMITH_PROJECT=bank-chatbot
LANGSMITH_TRACING_V2=true

# Guardrails
GUARDRAILS_CONFIG_DIR=./src/bank_chatbot/guardrails/config

# Evaluation
EVAL_GOLDEN_SET_PATH=./data/eval/golden_set.json
EVAL_THRESHOLD_FAITHFULNESS=0.85
EVAL_THRESHOLD_RELEVANCE=0.80
EVAL_THRESHOLD_PRECISION=0.75

# Security
SECRET_KEY=your_secret_key_change_in_production
AUTH_TOKEN=your_api_token_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=30
RATE_LIMIT_BURST=10

# Feature Flags
FEATURE_RAG_ENABLED=true
FEATURE_TOOLS_ENABLED=false
FEATURE_MULTI_AGENT_ENABLED=false
FEATURE_HUMAN_HANDOFF_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json